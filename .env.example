# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Google Tag Manager (optional — omit to skip loading GTM entirely)
NEXT_PUBLIC_GTM_ID=
# Search-engine ownership verification (optional — each omits its <meta> tag if unset)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
# App
APP_URL=http://localhost:3000
# Google OAuth (Gmail API)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Microsoft OAuth (MS Graph)
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# AES-256-GCM key mailbox OAuth tokens are encrypted with at rest.
# Generate with: openssl rand -hex 32
MAILBOX_ENCRYPTION_KEY="074d58e4404c9b88c0f7f6197fc0fa9c6ed32951dc1d24e4745154503e188ea6"
# QStash
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Pipeline providers (declared now, used in later phases)
BRIGHTDATA_API_KEY=
# Brightdata Web Unlocker zone name used to scrape full page content during research
BRIGHTDATA_SCRAPE_ZONE=
# Brightdata SERP API zone name used for web search during research — a
# distinct zone from BRIGHTDATA_SCRAPE_ZONE even though both go through
# https://api.brightdata.com/request; reusing the scrape zone here fails.
BRIGHTDATA_SERP_ZONE=
GEMINI_API_KEY=
APOLLO_API_KEY=
# Emailable — second-opinion deliverability check layered on Apollo's own
# email_status. Only `deliverable` activates a lead. See architecture.md §6.
EMAILABLE_API_KEY=
# Mailreach — continuous inbox-reputation warmup, independent of the daily-cap ramp.
MAILREACH_API_KEY=
# Optional: Uniforms Fashion's own Mailreach account, used only for that one
# client (see src/lib/mailreach/client-api-keys.ts). Every other client keeps
# using MAILREACH_API_KEY above.
MAILREACH_API_KEY_UNIFORMS_FASHION=
# CRM integrations (outbound push to a client's own HubSpot / Pipedrive)
HUBSPOT_OAUTH_CLIENT_ID=
HUBSPOT_OAUTH_CLIENT_SECRET=
PIPEDRIVE_OAUTH_CLIENT_ID=
PIPEDRIVE_OAUTH_CLIENT_SECRET=
# Reports — SMTP credentials for the personal weekly/monthly report emails
# (sent from Shengul directly, separate from the per-mailbox outreach system).
REPORTS_SMTP_HOST=
REPORTS_SMTP_PORT=
REPORTS_SMTP_SECURE=
REPORTS_SMTP_USERNAME=
REPORTS_SMTP_PASSWORD=
REPORTS_FROM_EMAIL=
REPORTS_FROM_NAME=
